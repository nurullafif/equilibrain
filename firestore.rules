rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'role', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128 && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.role is string && (data.role == 'student' || data.role == 'teacher' || data.role == 'admin')
        && (!('school' in data) || (data.school is string && data.school.size() <= 150))
        && (!('gradeClass' in data) || (data.gradeClass is string && data.gradeClass.size() <= 50))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 300))
        && (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 100))
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidModuleProgress(data) {
      return data.keys().hasAll(['id', 'userId', 'moduleId', 'isCompleted', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.moduleId is string && data.moduleId.size() <= 64
        && data.isCompleted is bool
        && (!('isUnlocked' in data) || data.isUnlocked is bool)
        && (!('lastVisitedPhase' in data) || (data.lastVisitedPhase is string && data.lastVisitedPhase.size() <= 64))
        && (!('completedPhases' in data) || (data.completedPhases is list && data.completedPhases.size() <= 10))
        && (!('quizScore' in data) || (data.quizScore is number && data.quizScore >= 0 && data.quizScore <= 100))
        && data.updatedAt is string;
    }

    function isValidELKPD(data) {
      return data.keys().hasAll(['id', 'userId', 'meetingNumber', 'submittedAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.meetingNumber is number && data.meetingNumber >= 1 && data.meetingNumber <= 8
        && (!('answers' in data) || data.answers is map)
        && data.submittedAt is string
        && data.updatedAt is string;
    }

    function isValidCER(data) {
      return data.keys().hasAll(['id', 'userId', 'moduleId', 'claim', 'submittedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.moduleId is string && data.moduleId.size() <= 64
        && data.claim is string && data.claim.size() <= 1000
        && (!('topicTitle' in data) || (data.topicTitle is string && data.topicTitle.size() <= 200))
        && (!('data' in data) || (data.data is string && data.data.size() <= 2000))
        && (!('warrant' in data) || (data.warrant is string && data.warrant.size() <= 2000))
        && (!('backing' in data) || (data.backing is string && data.backing.size() <= 2000))
        && (!('qualifier' in data) || (data.qualifier is string && data.qualifier.size() <= 1000))
        && (!('rebuttal' in data) || (data.rebuttal is string && data.rebuttal.size() <= 1500))
        && data.submittedAt is string;
    }

    function isValidReflection(data) {
      return data.keys().hasAll(['id', 'userId', 'moduleId', 'conceptualUnderstanding', 'submittedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.moduleId is string && data.moduleId.size() <= 64
        && data.conceptualUnderstanding is string && data.conceptualUnderstanding.size() <= 2000
        && (!('difficultyRating' in data) || (data.difficultyRating is number && data.difficultyRating >= 1 && data.difficultyRating <= 5))
        && data.submittedAt is string;
    }

    // 2. User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false; // Strict privacy: never list all users
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;

      // Module Progress Subcollection
      match /moduleProgress/{moduleId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidId(moduleId) && isValidModuleProgress(incoming());
        allow update: if isSignedIn() && isOwner(userId) && isValidId(moduleId) && isValidModuleProgress(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().moduleId == existing().moduleId;
        allow delete: if false;
      }

      // e-LKPD Submissions Subcollection
      match /elkpdSubmissions/{submissionId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidId(submissionId) && isValidELKPD(incoming());
        allow update: if isSignedIn() && isOwner(userId) && isValidId(submissionId) && isValidELKPD(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().submittedAt == existing().submittedAt;
        allow delete: if false;
      }

      // CER Argumentation Subcollection
      match /cerSubmissions/{cerId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidId(cerId) && isValidCER(incoming());
        allow update: if isSignedIn() && isOwner(userId) && isValidId(cerId) && isValidCER(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().submittedAt == existing().submittedAt;
        allow delete: if false;
      }

      // Metacognitive Reflections Subcollection
      match /reflections/{reflectionId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidId(reflectionId) && isValidReflection(incoming());
        allow update: if isSignedIn() && isOwner(userId) && isValidId(reflectionId) && isValidReflection(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if false;
      }
    }

    // Test connection doc for initial boot check
    match /test/{docId} {
      allow get: if true;
    }
  }
}
